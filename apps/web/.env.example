# En desarrollo, true activa el proveedor de demostración de autenticación.
VITE_USE_MOCK_AUTH=false

# Por defecto el modo de resumen sigue el modo de autenticación. Define true
# para forzar la demostración o false al conectar ambos flujos al backend.
# VITE_USE_MOCK_SUMMARY=false

# URL base de FastAPI cuando el backend esté disponible.
VITE_API_URL=http://localhost:8000
