# Plantilla de variables de entorno de ResumeDoc (apps/api).
# Copia este archivo como .env y rellena las variables obligatorias.
# .env NO se versiona (está en .gitignore): nunca commitees secretos.

# Secreto de firma de tokens JWT (spec D-06).
# Genera uno fuerte, por ejemplo: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ACCESS_TTL=1800
JWT_REFRESH_TTL=604800

# Persistencia (spec D-13): PostgreSQL (rama data-base). El valor
# `memory://` usa los dobles en memoria (tests / ejecución sin BD).
DATABASE_URL=postgresql://usuario:clave@localhost:5432/resumedoc
REDIS_URL=redis://localhost:6379/0
STORAGE_DIR=storage

# Límites provisionales (spec D-17).
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=100
PROCESS_TIMEOUT_S=300

# OCR (spec D-03).
OCR_LANG=spa

# Resúmenes con Ollama. La configuración por defecto usa una instancia local:
# instala Ollama, ejecuta `ollama pull llama3.2` y deja el servicio activo.
# Si la API corre en un contenedor, OLLAMA_BASE_URL debe apuntar a un host
# accesible desde ese contenedor, no a localhost.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_API_STYLE=auto
OLLAMA_TIMEOUT_S=180
# Para Ollama Cloud usa su URL compatible con OpenAI y configura la clave:
# OLLAMA_BASE_URL=https://ollama.com/v1
# OLLAMA_API_KEY=

# Bootstrap del primer admin (spec D-22): OPCIONALES. Solo si defines ambas
# se crea el administrador inicial al arrancar (si el usuario ya existe, no
# se toca). Nunca se crea un admin vía endpoint.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
