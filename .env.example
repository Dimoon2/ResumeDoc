# ResumeDoc — plantilla de entorno
# Copia este archivo a `.env` en la RAÍZ (Alembic y scripts/check_db) y a
# `apps/api/.env` (API y worker). Rellena TODAS las obligatorias: el backend
# falla al arrancar si falta alguna.

# --- Base de datos -------------------------------------------------------
# Neon -> Connection Details -> Direct connection (NO la pooled).
# Cambia el esquema postgresql:// por postgresql+psycopg://
# En local: postgresql+psycopg://resumedoc:resumedoc@localhost:5434/resumedoc
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require

# --- Redis (cola Celery y estado de documentos) --------------------------
REDIS_URL=redis://localhost:6379/0

# --- Almacenamiento de archivos ------------------------------------------
STORAGE_DIR=storage

# --- JWT -----------------------------------------------------------------
# Secreto de al menos 32 caracteres (obligatorio, sin valor por defecto).
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-32
JWT_ACCESS_TTL=1800
JWT_REFRESH_TTL=604800

# --- Límites de subida y pipeline (D-17) ---------------------------------
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=100
PROCESS_TIMEOUT_S=300
OCR_LANG=spa

# --- HTTP / frontend -----------------------------------------------------
# Orígenes del front separados por comas. Default: http://localhost:5173
CORS_ORIGINS=http://localhost:5173
# `true` solo con HTTPS (producción). En desarrollo HTTP debe ser `false`.
COOKIE_SECURE=false

# --- Bootstrap del primer admin (opcional, nunca vía endpoint) -----------
# ADMIN_EMAIL=root@correo.com
# ADMIN_PASSWORD=cambia-esta-clave
